pipeline {
    agent { label "python" }

    triggers {
        pollSCM('H/3 * * * *')
    }

    environment {
        APP = "Inventory"
        ENV = "Development"
    }

    stages {
        stage('Retry Build') {
            steps {
                script {
                    retry(3) {
                        sh "true"
                    }
                }
            }
        }

        stage('Sleep') {
            steps {
                echo 'Waiting...'
                sleep 20
                echo 'Deployment Starting...'
            }
        }

        stage('Task 4 - Input Approval') {
            steps {
                script {
                    input message: 'Deploy to Production?', ok: 'Approve'
                    echo "Deployment approved"
                }
            }
        }

        stage('Task 5 - User Selection') {
            steps {
                script {
                    def envChoice = input(
                        message: 'Choose target environment',
                        parameters: [
                            choice(
                                name: 'ENVIRONMENT',
                                choices: "Dev\nQA\nUAT\nProduction",
                                description: 'Select deployment environment'
                            )
                        ]
                    )
                    echo "Selected environment: ${envChoice}"
                }
            }
        }

        stage('Task 6 - Error Handling') {
            steps {
                script {
                    try {
                        sh "abcd"
                    } catch (Exception e) {
                        echo "Command Failed"
                    }
                    echo "Pipeline continues..."
                }
            }
        }

        stage('Task 7 - Build Status') {
            steps {
                script {
                    echo "Build Number: ${currentBuild.number}"
                    echo "Build Result: ${currentBuild.result}"
                    echo "Build Duration: ${currentBuild.duration}"
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline completed"
        }
    }
}